<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="20260625-account-management-init" author="copilot">
        <createTable tableName="accounts">
            <column name="account_id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(24)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="account_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="nickname" type="VARCHAR(64)"/>
            <column name="balance" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="opened_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at_utc" type="TIMESTAMP"/>
            <column name="created_by_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>

        <createTable tableName="account_eligibility_checks">
            <column name="check_id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="account_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="evaluated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_eligible" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code" type="VARCHAR(128)"/>
            <column name="metadata" type="TEXT"/>
        </createTable>

        <createTable tableName="account_lifecycle_events">
            <column name="event_id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="VARCHAR(36)"/>
            <column name="event_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_role" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code" type="VARCHAR(128)"/>
            <column name="metadata" type="TEXT"/>
        </createTable>

        <createTable tableName="account_deletion_policy_checks">
            <column name="check_id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="evaluated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="has_dependency_blocker" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="has_retention_blocker" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="blocker_reasons" type="TEXT"/>
            <column name="decision" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
